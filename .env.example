# Cadena de conexión para SQL Server
# Formato compatible con variables de entorno de ASP.NET Core:
ConnectionStrings__Restaurante=Server=(localdb)\MSSQLLocalDB;Database=Restaurante;Trusted_Connection=True;TrustServerCertificate=True

# Configuración de JWT (clave mínima de 32 caracteres)
Jwt__Key=restaurante-itq-2026-clave-secreta-de-mas-de-32-caracteres
Jwt__Issuer=RestauranteApi
Jwt__Audience=RestauranteApp
Jwt__MinutosExpiracion=480

# URL base para menú y códigos QR
App__UrlMenu=http://localhost:5205/menu
