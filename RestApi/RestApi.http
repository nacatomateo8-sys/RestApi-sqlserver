@RestApi_HostAddress = http://localhost:5205

### ====================================================
### MÓDULO 1: PLATOS
### ====================================================

### 1) Ver todos los platos -> 200
GET {{RestApi_HostAddress}}/platos

### 2) Ver un plato -> 200
GET {{RestApi_HostAddress}}/platos/1

### 3) Plato inexistente -> 404
GET {{RestApi_HostAddress}}/platos/999

### 4) Crear nuevo plato -> 201
POST {{RestApi_HostAddress}}/platos
Content-Type: application/json

{
  "nombre": "Seco de chivo",
  "descripcion": "Chivo guisado con cerveza y naranjilla",
  "precio": 8.50,
  "categoriaId": 2
}

### 5) Actualizar plato -> 200
PUT {{RestApi_HostAddress}}/platos/1
Content-Type: application/json

{
  "nombre": "Ceviche mixto",
  "descripcion": "Camarón y pescado fresco",
  "precio": 9.00,
  "categoriaId": 1
}

### 6) Precio inválido (0) -> 400
PUT {{RestApi_HostAddress}}/platos/1
Content-Type: application/json

{
  "nombre": "Ceviche mixto",
  "descripcion": "Camarón y pescado",
  "precio": 0,
  "categoriaId": 1
}

### 7) Eliminar plato (borrado lógico) -> 204
DELETE {{RestApi_HostAddress}}/platos/5

### 8) Eliminar plato ya inexistente -> 404
DELETE {{RestApi_HostAddress}}/platos/999


### ====================================================
### MÓDULO 2: CATEGORÍAS
### ====================================================

### 1) Listar categorías -> 200
GET {{RestApi_HostAddress}}/categorias

### 2) Ver categoría por Id -> 200
GET {{RestApi_HostAddress}}/categorias/1

### 3) Crear categoría -> 201
POST {{RestApi_HostAddress}}/categorias
Content-Type: application/json

{
  "nombre": "Especialidades del Chef"
}


### ====================================================
### MÓDULO 3: MESAS Y GENERACIÓN QR
### ====================================================

### 1) Listar todas las mesas -> 200
GET {{RestApi_HostAddress}}/mesas

### 2) Ver mesa por Id -> 200
GET {{RestApi_HostAddress}}/mesas/1

### 3) Crear mesa -> 201
POST {{RestApi_HostAddress}}/mesas
Content-Type: application/json
 
{
  "numero": 10,
  "capacidad": 4
}

### 4) Capacidad inválida -> 400
POST {{RestApi_HostAddress}}/mesas
Content-Type: application/json

{
  "numero": 11,
  "capacidad": 0
}

### 5) Obtener código QR de la mesa -> 200 (PNG)
GET {{RestApi_HostAddress}}/mesas/1/qr
